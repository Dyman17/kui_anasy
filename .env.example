# PostgreSQL connection string from your Render database
DATABASE_URL=postgresql://user:password@localhost:5432/kui_anasy
# Generate a long random value; admins enter this in the editor
ADMIN_TOKEN=replace-with-a-long-random-secret
# Comma-separated frontend origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Set to true when connecting to Render PostgreSQL
DATABASE_SSL=false
# Vite frontend API URL (local development default)
VITE_API_URL=http://localhost:4000
